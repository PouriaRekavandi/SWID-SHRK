{
  "name": "swid-shrk",
  "version": "1.0.0",
  "description": "SWID-SHRK — Mechanical & Aerospace Research Lab",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "predev": "node scripts/ensure-assets.js",
    "dev": "tsx server.ts",
    "prebuild": "node scripts/ensure-assets.js",
    "build": "node scripts/ensure-assets.js && vite build && touch dist/.nojekyll && rm -rf docs && cp -r dist docs && touch docs/.nojekyll",
    "start": "node server.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.58.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
